# Which backend to talk to: prod (Oracle) or local (Docker on this Mac).
# See src/config/environment.ts. Leave EXPO_PUBLIC_API_BASE_URL unset unless
# you need a one-off host such as a tunnel — it overrides the choice below.
EXPO_PUBLIC_ENV=prod
# EXPO_PUBLIC_API_BASE_URL=


# AdMob unit IDs — one set per platform (each unit belongs to one AdMob app)
# iOS (app: ca-app-pub-7901427966550188~2815899433)
EXPO_PUBLIC_ADMOB_REWARDED_ID_IOS=ca-app-pub-7901427966550188/7431334232
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-7901427966550188/3931072922
# Android (app: ca-app-pub-7901427966550188~6992350531)
EXPO_PUBLIC_ADMOB_REWARDED_ID_ANDROID=ca-app-pub-7901427966550188/4142825911
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-7901427966550188/5837648596
# true = Google test ads on all platforms (no revenue, safe for dev). Set false for production builds.
EXPO_PUBLIC_ADMOB_TEST_MODE=true


# Where push tokens are registered. Deliberately not in app.json:
# a projectId there makes Expo Go check the viewer against the project's
# owner, which stops anyone else opening the shared dev link.
EXPO_PUBLIC_EAS_PROJECT_ID=c7ff1d39-b980-4881-abe2-0c709c00e211
